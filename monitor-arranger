def _ensure_layer_shell_preload():
    """gtk4-layer-shell (used by "Identify") must be loaded before
    libwayland-client: from Python the only way is LD_PRELOAD, so we
    re-exec ourselves once."""
    if not os.path.exists(LAYER_SHELL_LIB) or os.environ.get("MONITOR_ARRANGER_REEXEC"):
        return
    env = dict(os.environ)
    env["LD_PRELOAD"] = " ".join(filter(None, [LAYER_SHELL_LIB, env.get("LD_PRELOAD")]))
    env["MONITOR_ARRANGER_REEXEC"] = "1"
    try:
        os.execve(sys.executable, [sys.executable, os.path.abspath(sys.argv[0]), *sys.argv[1:]], env)
    except OSError:
        pass


