class LayoutCanvas(Gtk.DrawingArea):
    def __init__(self, win):
        super().__init__(hexpand=True, vexpand=True, focusable=True)
        self.win = win
        self.zoom, self.ox, self.oy, self.px, self.py = 0.1, 0, 0, 0, 0
        self.frozen = False   # the view does not refit while dragging
        self.drag = None
        self.guides = []
        self.hover = None
        self.set_draw_func(self._draw)

        drag = Gtk.GestureDrag()
        drag.connect("drag-begin", self._on_drag_begin)
        drag.connect("drag-update", self._on_drag_update)
        drag.connect("drag-end", self._on_drag_end)
        self.add_controller(drag)

        motion = Gtk.EventControllerMotion()
        motion.connect("motion", self._on_motion)
        motion.connect("leave", lambda *_: self._set_hover(None))
        self.add_controller(motion)

        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self._on_key)
        self.add_controller(keys)

    # ----- transforms -----
    def fit(self):
        if self.frozen:
            return
        w, h = self.get_width() or 800, self.get_height() or 500
        mons = self.win.layout_monitors()
        if not mons:
            self.zoom, self.ox, self.oy, self.px, self.py = 0.1, 0, 0, w / 2, h / 2
            return
        min_x = min(m.x for m in mons)
        min_y = min(m.y for m in mons)
        bw = max(max(m.x + m.logical_w for m in mons) - min_x, 1)
        bh = max(max(m.y + m.logical_h for m in mons) - min_y, 1)
        pad, pad_bottom = 56, 84
        zoom = min((w - 2 * pad) / bw, (h - pad - pad_bottom) / bh)
        self.zoom = max(min(zoom, 0.5), 0.01)
        self.ox, self.oy = min_x, min_y
        self.px = (w - bw * self.zoom) / 2
        self.py = pad + ((h - pad - pad_bottom) - bh * self.zoom) / 2

    def to_canvas(self, x, y):
        return (x - self.ox) * self.zoom + self.px, (y - self.oy) * self.zoom + self.py

    def to_logical(self, cx, cy):
        return (cx - self.px) / self.zoom + self.ox, (cy - self.py) / self.zoom + self.oy

    def monitor_at(self, cx, cy):
        lx, ly = self.to_logical(cx, cy)
        for mon in reversed(self._draw_order()):
            if mon.x <= lx <= mon.x + mon.logical_w and mon.y <= ly <= mon.y + mon.logical_h:
                return mon
        return None

    def _draw_order(self):
        lay = self.win.layout_monitors()
        top = self.drag["mon"] if self.drag else self.win.selected
        return sorted(lay, key=lambda m: m is top)

    # ----- drawing -----
    def _font(self, size, bold=False):
        fd = self.get_pango_context().get_font_description().copy()
        fd.set_absolute_size(size * Pango.SCALE)
        fd.set_weight(Pango.Weight.BOLD if bold else Pango.Weight.NORMAL)
        return fd

    def _text(self, cr, text, x, y, size, color, alpha=1.0, bold=False, width=None, center=False):
        layout = PangoCairo.create_layout(cr)
        layout.set_font_description(self._font(size, bold))
        layout.set_text(text, -1)
        if width:
            layout.set_width(int(width * Pango.SCALE))
            layout.set_ellipsize(Pango.EllipsizeMode.END)
            if center:
                layout.set_alignment(Pango.Alignment.CENTER)
        cr.set_source_rgba(*color, alpha)
        cr.move_to(x, y)
        PangoCairo.show_layout(cr, layout)
        return layout.get_pixel_size()

    def _draw(self, area, cr, w, h):
        self.fit()
        t = self.win.theme
        fg, muted = rgb(t["foreground"]), rgb(t["muted"])
        cr.set_source_rgb(*rgb(t["darker_background"]))
        cr.paint()

        cr.set_source_rgba(*muted, 0.30)
        step = 24
        for gx in range(step // 2, w, step):
            for gy in range(step // 2, h, step):
                cr.rectangle(gx, gy, 1.6, 1.6)
        cr.fill()

        layout = self.win.layout_monitors()
        if not layout:
            self._text(cr, "No active screen in the layout", 0, h / 2 - 12, 16, muted,
                       width=w, center=True)
            return

        bad = self.win.overlapping_names()
        for mon in self._draw_order():
            self._draw_monitor(cr, mon, mon.name in bad, fg, muted)

        accent = rgb(t["accent"])
        cr.set_source_rgba(*accent, 0.9)
        cr.set_line_width(1.2)
        cr.set_dash([6, 5])
        for kind, value in self.guides:
            if kind == "v":
                cx, _ = self.to_canvas(value, 0)
                cr.move_to(round(cx) + 0.5, 0)
                cr.line_to(round(cx) + 0.5, h)
            else:
                _, cy = self.to_canvas(0, value)
                cr.move_to(0, round(cy) + 0.5)
                cr.line_to(w, round(cy) + 0.5)
        cr.stroke()
        cr.set_dash([])

        if self.drag:
            mon = self.drag["mon"]
            label = f"{int(round(mon.x))}, {int(round(mon.y))}"
            cx, cy = self.to_canvas(mon.x, mon.y)
            self._chip(cr, label, cx, cy - 30, accent)

        lay_w = max(m.x + m.logical_w for m in layout) - min(m.x for m in layout)
        lay_h = max(m.y + m.logical_h for m in layout) - min(m.y for m in layout)
        layout = PangoCairo.create_layout(cr)
        layout.set_font_description(self._font(11))
        layout.set_text(f"Total area {int(lay_w)} × {int(lay_h)} logical px", -1)
        tw, th = layout.get_pixel_size()
        cr.set_source_rgba(*muted, 1.0)
        cr.move_to(w - tw - 18, h - th - 22)
        PangoCairo.show_layout(cr, layout)

    def _chip(self, cr, text, x, y, color):
        layout = PangoCairo.create_layout(cr)
        layout.set_font_description(self._font(11, True))
        layout.set_text(text, -1)
        tw, th = layout.get_pixel_size()
        rounded_rect(cr, x, y, tw + 16, th + 8, (th + 8) / 2)
        cr.set_source_rgba(*color, 0.95)
        cr.fill()
        cr.set_source_rgb(1, 1, 1)
        cr.move_to(x + 8, y + 4)
        PangoCairo.show_layout(cr, layout)

    def _draw_monitor(self, cr, mon, overlapping, fg, muted):
        x, y = self.to_canvas(mon.x, mon.y)
        mw, mh = mon.logical_w * self.zoom, mon.logical_h * self.zoom
        color = self.win.color_of(mon)
        selected = mon is self.win.selected
        hovered = mon is self.hover
        r = min(12, mw / 8, mh / 8)

        if selected:
            rounded_rect(cr, x - 5, y - 5, mw + 10, mh + 10, r + 5)
            cr.set_source_rgba(*color, 0.28)
            cr.fill()

        rounded_rect(cr, x, y, mw, mh, r)
        cr.set_source_rgb(*rgb(self.win.theme["lighter_background"]))
        cr.fill_preserve()
        cr.set_source_rgba(*color, 0.34 if selected else 0.24 if hovered else 0.16)
        cr.fill_preserve()
        cr.set_source_rgba(*color, 1.0 if selected or hovered else 0.75)
        cr.set_line_width(2.5 if selected else 1.5)
        cr.stroke()

        if overlapping:
            rounded_rect(cr, x + 3, y + 3, mw - 6, mh - 6, max(r - 3, 0))
            cr.set_source_rgba(*rgb(self.win.theme["red"]), 0.95)
            cr.set_line_width(2)
            cr.set_dash([7, 5])
            cr.stroke()
            cr.set_dash([])

        # "top" edge of the image: makes the rotation readable
        edge = {0: "top", 1: "right", 2: "bottom", 3: "left",
                4: "top", 5: "left", 6: "bottom", 7: "right"}[mon.transform]
        bar = 4
        cr.set_source_rgba(*color, 0.9)
        if edge == "top":
            cr.rectangle(x + mw * 0.3, y + 6, mw * 0.4, bar)
        elif edge == "bottom":
            cr.rectangle(x + mw * 0.3, y + mh - 6 - bar, mw * 0.4, bar)
        elif edge == "left":
            cr.rectangle(x + 6, y + mh * 0.3, bar, mh * 0.4)
        else:
            cr.rectangle(x + mw - 6 - bar, y + mh * 0.3, bar, mh * 0.4)
        cr.fill()

        inner = mw - 20
        if inner < 24:
            return
        name_size = max(11, min(30, mh * 0.11, mw * 0.08))
        lines = [(mon.name, name_size, True, 1.0)]
        if mh > 70 and mw > 110:
            lines.append((f"{mon.width}×{mon.height} · {fmt_refresh(mon.refresh)} Hz", name_size * 0.62, False, 0.85))
            info = f"scale {scale_label(mon.scale)} · {int(round(mon.logical_w))}×{int(round(mon.logical_h))}"
            if mon.transform:
                info += f" · {TRANSFORMS[mon.transform][1].lower()}"
            lines.append((info, name_size * 0.56, False, 0.7))
            mirrors = [m.name for m in self.win.monitors if m.mirror == mon.name and not m.disabled]
            if mirrors:
                lines.append((f"mirrored on {', '.join(mirrors)}", name_size * 0.56, False, 0.7))
        total = sum(s * 1.45 for _, s, _, _ in lines)
        ty = y + (mh - total) / 2
        for text, size, bold, alpha in lines:
            self._text(cr, text, x + 10, ty, size, fg, alpha, bold, width=inner, center=True)
            ty += size * 1.45
        if mh > 90 and mw > 140:
            self._text(cr, f"{int(round(mon.x))}, {int(round(mon.y))}", x + 12, y + mh - 24, 10.5, muted, 1.0)

    # ----- interaction -----
    def _set_hover(self, mon):
        if mon is not self.hover:
            self.hover = mon
            self.set_cursor_from_name("grab" if mon else "default")
            self.queue_draw()

    def _on_motion(self, _ctrl, x, y):
        if not self.drag:
            self._set_hover(self.monitor_at(x, y))

    def _on_drag_begin(self, _gesture, sx, sy):
        self.grab_focus()
        mon = self.monitor_at(sx, sy)
        if mon is None:
            return
        self.win.select(mon)
        self.frozen = True
        self.drag = {"mon": mon, "x": mon.x, "y": mon.y, "before": self.win.snapshot(),
                     "sticky": (None, None)}
        self.set_cursor_from_name("grabbing")
        self.queue_draw()

    def _on_drag_update(self, gesture, dx, dy):
        if not self.drag:
            return
        mon = self.drag["mon"]
        nx = self.drag["x"] + dx / self.zoom
        ny = self.drag["y"] + dy / self.zoom
        shift = gesture.get_current_event_state() & Gdk.ModifierType.SHIFT_MASK
        if self.win.snap_enabled and not shift:
            others = [m for m in self.win.layout_monitors() if m is not mon]
            nx, ny, self.guides, self.drag["sticky"] = snap_position(
                mon, nx, ny, others, SNAP_PX / self.zoom, self.drag["sticky"])
        else:
            self.guides, self.drag["sticky"] = [], (None, None)
        nx, ny = int(round(nx)), int(round(ny))
        if (nx, ny) == (mon.x, mon.y):
            return
        mon.x, mon.y = nx, ny
        self.win.after_change(live=True)

    def _on_drag_end(self, _gesture, _dx, _dy):
        if not self.drag:
            return
        mon, start = self.drag["mon"], (self.drag["x"], self.drag["y"])
        before = self.drag["before"]
        self.drag, self.frozen, self.guides = None, False, []
        self.set_cursor_from_name("grab" if self.hover else "default")
        if (mon.x, mon.y) != start:
            self.win.push_undo(snap=before)
            self.win.normalize()
        self.win.after_change()

    def _on_key(self, _ctrl, keyval, _code, state):
        if keyval == Gdk.KEY_Tab:
            self.win.select_next()
            return True
        mon = self.win.selected
        if not mon or not mon.in_layout:
            return False
        step = 100 if state & Gdk.ModifierType.SHIFT_MASK else 1 if state & Gdk.ModifierType.ALT_MASK else 10
        delta = {Gdk.KEY_Left: (-step, 0), Gdk.KEY_Right: (step, 0),
                 Gdk.KEY_Up: (0, -step), Gdk.KEY_Down: (0, step)}.get(keyval)
        if not delta:
            return False
        self.win.push_undo(key=f"nudge-{mon.name}")
        mon.x += delta[0]
        mon.y += delta[1]
        self.win.after_change()
        return True


