        self.mock = mock
        self.theme = theme
        self.palette = palette
        self.monitors = monitors
        self.selected = None
        self.snap_enabled = True
        self.undo_stack = []
        self._undo_key, self._undo_time = None, 0.0
        self._syncing = False
        self._pending_revert = None
        self._identify_windows = []
        self._list_rows = []
        self._setting_rows = []
