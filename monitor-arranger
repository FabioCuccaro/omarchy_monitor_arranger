# geometry
# ---------------------------------------------------------------------------

def overlaps(a, b):
    return (a.x < b.x + b.logical_w - 0.5 and b.x < a.x + a.logical_w - 0.5 and
            a.y < b.y + b.logical_h - 0.5 and b.y < a.y + a.logical_h - 0.5)


def touches(a, b):
    v_overlap = min(a.y + a.logical_h, b.y + b.logical_h) - max(a.y, b.y)
    h_overlap = min(a.x + a.logical_w, b.x + b.logical_w) - max(a.x, b.x)
    side = (abs(a.x + a.logical_w - b.x) < 1 or abs(b.x + b.logical_w - a.x) < 1) and v_overlap > 0
    stacked = (abs(a.y + a.logical_h - b.y) < 1 or abs(b.y + b.logical_h - a.y) < 1) and h_overlap > 0
    return side or stacked or overlaps(a, b)


def detached_monitors(layout):
    """Screens the cursor cannot reach from the main group."""
    if len(layout) < 2:
        return []
    groups, left = [], list(layout)
    while left:
        group, queue = [], [left.pop(0)]
        while queue:
            cur = queue.pop()
            group.append(cur)
            for o in [o for o in left if touches(cur, o)]:
                left.remove(o)
                queue.append(o)
        groups.append(group)
    main = max(groups, key=lambda g: sum(m.logical_w * m.logical_h for m in g))
    return [m for g in groups if g is not main for m in g]


def snap_position(mon, x, y, others, threshold, sticky=(None, None)):
    """Snap (x, y) to the edges, adjacencies and centres of the other screens.
    sticky holds the previous step's snaps: they stay active until you move
    1.6 times the threshold away (hysteresis), so it doesn't jump back and
    forth near the limit. Returns (x, y, guides, sticky)."""
    w, h = mon.logical_w, mon.logical_h
    cands_x, cands_y = [], []
    for o in others:
        ox, oy, ow, oh = o.x, o.y, o.logical_w, o.logical_h
        cands_x += [(ox + ow, ox + ow), (ox - w, ox), (ox, ox),
                    (ox + ow - w, ox + ow), (ox + (ow - w) / 2, ox + ow / 2)]
        cands_y += [(oy + oh, oy + oh), (oy - h, oy), (oy, oy),
                    (oy + oh - h, oy + oh), (oy + (oh - h) / 2, oy + oh / 2)]

    def pick(raw, cands, prev):
        if prev is not None:
            for cand, guide in cands:
                if abs(cand - prev) < 0.5 and abs(cand - raw) < threshold * 1.6:
                    return cand, guide
        best = min(cands, key=lambda c: abs(c[0] - raw), default=None)
        if best and abs(best[0] - raw) < threshold:
            return best
        return None, None

    sx, gx = pick(x, cands_x, sticky[0])
    sy, gy = pick(y, cands_y, sticky[1])
    guides = []
    if sx is not None:
        x = sx
        guides.append(("v", gx))
    if sy is not None:
        y = sy
        guides.append(("h", gy))
    return x, y, guides, (sx, sy)


# ---------------------------------------------------------------------------
# monitors.lua
# ---------------------------------------------------------------------------

BLOCK_START = re.compile(r"^[ \t]*hl\.monitor\s*\(\s*\{", re.M)


def split_top_level(body):
    """Split the body of a Lua table into (key, raw value) pairs."""
    parts, cur, depth, in_str, i = [], [], 0, None, 0
    while i < len(body):
        c = body[i]
        if in_str:
            cur.append(c)
            if c == "\\" and i + 1 < len(body):
                cur.append(body[i + 1])
                i += 1
            elif c == in_str:
                in_str = None
        elif c in "\"'":
            in_str = c
            cur.append(c)
        elif body.startswith("--", i):
            nl = body.find("\n", i)
            i = len(body) if nl < 0 else nl
            continue
        elif c in "{(":
            depth += 1
            cur.append(c)
        elif c in "})":
            depth -= 1
            cur.append(c)
        elif c == "," and depth == 0:
            parts.append("".join(cur))
            cur = []
        else:
            cur.append(c)
        i += 1
    parts.append("".join(cur))
    fields = []
    for p in parts:
        m = re.match(r"^\s*([A-Za-z_]\w*)\s*=\s*(.+?)\s*$", p, re.S)
        if m:
            fields.append((m[1], m[2]))
    return fields


def find_monitor_blocks(text):
    """Find the hl.monitor({...}) calls that are not commented out."""
    blocks = []
    for m in BLOCK_START.finditer(text):
        start = m.start() + len(m[0]) - len(m[0].lstrip(" \t"))
        i, depth, in_str = m.end(), 1, None
        while i < len(text) and depth:
            c = text[i]
            if in_str:
                if c == "\\":
                    i += 1
                elif c == in_str:
                    in_str = None
            elif c in "\"'":
                in_str = c
            elif text.startswith("--", i):
                nl = text.find("\n", i)
                i = len(text) if nl < 0 else nl
                continue
            elif c == "{":
                depth += 1
            elif c == "}":
                depth -= 1
            i += 1
        if depth:
            continue
        j = i
        while j < len(text) and text[j] in " \t\r\n":
            j += 1
        if j >= len(text) or text[j] != ")":
            continue
        blocks.append({"start": start, "end": j + 1, "fields": split_top_level(text[m.end():i - 1])})
    return blocks


def lua_unquote(raw):
    raw = raw.strip()
    if len(raw) >= 2 and raw[0] == raw[-1] and raw[0] in "\"'":
        return raw[1:-1]
    return None


def block_output(block):
    return next((lua_unquote(v) for k, v in block["fields"] if k == "output"), None)


def output_matches(out, mon):
    if out == mon.name:
        return True
    desc = out[5:].strip() if out.startswith("desc:") else ""
    return bool(desc) and mon.description.startswith(desc)


def render_block(mon, old_fields=None, output_raw=None):
    fields = mon.lua_fields()
    if output_raw:
        fields[0] = ("output", output_raw)
    extra = [(k, v) for k, v in (old_fields or []) if k not in MANAGED_KEYS]
    return "\n".join(["hl.monitor({"] + [f"  {k} = {v}," for k, v in fields + extra] + ["})"])


def update_config_text(text, monitors):
    """Rewrite the blocks of the given monitors leaving everything else
    untouched (comments, variables, the catch-all output = "" rule, extra fields)."""
    blocks = find_monitor_blocks(text)
    edits, appended, used = [], [], set()
    for mon in monitors:
        mine = [b for b in blocks
                if id(b) not in used and (o := block_output(b)) and output_matches(o, mon)]
        if not mine:
            appended.append(render_block(mon))
            continue
        first = mine[0]
        used.update(id(b) for b in mine)
        out_raw = next(v for k, v in first["fields"] if k == "output")
        edits.append((first["start"], first["end"], render_block(mon, first["fields"], out_raw)))
        for dup in mine[1:]:
            # a duplicate rule would override ours: comment it out
            old = text[dup["start"]:dup["end"]]
            edits.append((dup["start"], dup["end"],
                          "-- duplicate disabled by monitor-arranger:\n"
                          + "\n".join("-- " + line for line in old.splitlines())))
    for start, end, rep in sorted(edits, reverse=True):
        text = text[:start] + rep + text[end:]
    if appended:
        text = text.rstrip("\n")
        text = (text + "\n\n" if text else CONFIG_HEADER + "\n") + "\n\n".join(appended) + "\n"
    return text


def write_config(path, monitors):
    """Write monitors.lua and return (original text or None, backup)."""
    path.parent.mkdir(parents=True, exist_ok=True)
    original = path.read_text() if path.exists() else None
    backup = None
    if original is not None:
        backup = path.with_name(f"{path.name}.bak.{datetime.now():%Y%m%d%H%M%S}")
        shutil.copy2(path, backup)
        old = sorted(path.parent.glob(f"{path.name}.bak.*"), key=lambda p: p.stat().st_mtime)
        for p in old[:-MAX_BACKUPS]:
            p.unlink(missing_ok=True)
    # write in place (no rename): Hyprland watches the file for auto-reload
    path.write_text(update_config_text(original or "", monitors))
    return original, backup


