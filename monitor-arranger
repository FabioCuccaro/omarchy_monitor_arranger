# hyprctl
# ---------------------------------------------------------------------------

def _child_env():
    env = dict(os.environ)
    preload = [p for p in env.get("LD_PRELOAD", "").split() if p != LAYER_SHELL_LIB]
    if preload:
        env["LD_PRELOAD"] = " ".join(preload)
    else:
        env.pop("LD_PRELOAD", None)
    env.pop("MONITOR_ARRANGER_REEXEC", None)
    return env


CHILD_ENV = _child_env()


class HyprError(RuntimeError):
    pass


def hyprctl(*args, timeout=5):
    try:
        r = subprocess.run(["hyprctl", *args], capture_output=True, text=True,
                           timeout=timeout, env=CHILD_ENV)
    except FileNotFoundError:
        raise HyprError("hyprctl not found: you don't seem to be running inside Hyprland.")
    except subprocess.TimeoutExpired:
        raise HyprError("hyprctl is not responding.")
    if r.returncode != 0:
        raise HyprError((r.stderr or r.stdout).strip() or f"hyprctl {args[0]} failed ({r.returncode})")
    return r.stdout


def read_live_monitors():
    try:
        return json.loads(hyprctl("monitors", "all", "-j"))
    except json.JSONDecodeError as e:
        raise HyprError(f"invalid hyprctl output: {e}")


def hypr_eval(lua):
    # With the Lua config `hyprctl keyword` no longer works (and still exits
    # with code 0): the only reliable way is eval, which answers "ok".
    out = hyprctl("eval", lua).strip()
    if out != "ok":
        raise HyprError(out or "empty answer from hyprctl eval")


def config_errors():
    out = hyprctl("-j", "configerrors")
    try:
        errors = json.loads(out)
    except json.JSONDecodeError:
        errors = out.splitlines()
    return [e for e in errors if isinstance(e, str) and e.strip()]


# ---------------------------------------------------------------------------
# formatting
# ---------------------------------------------------------------------------

def fmt_num(v, digits=6):
    s = f"{v:.{digits}f}".rstrip("0").rstrip(".")
    return s or "0"


def fmt_scale(scale):
    return fmt_num(scale, 6)


def scale_label(scale):
    return fmt_num(scale, 3)


def fmt_refresh(rr):
    if abs(rr - round(rr)) < 0.01:
        return str(int(round(rr)))
    return f"{rr:.2f}"


def lua_str(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


MODE_RE = re.compile(r"^(\d+)x(\d+)@([\d.]+)")


def parse_modes(raw):
    seen, modes = set(), []
    for s in raw:
        m = MODE_RE.match(s)
        if not m:
            continue
        mode = (int(m[1]), int(m[2]), round(float(m[3]), 2))
        if mode not in seen:
            seen.add(mode)
            modes.append(mode)
    return modes


def valid_scales(w, h):
    """Scales that keep the logical resolution integral: Hyprland works in
    1/120 steps and rejects (or adjusts) scales that give fractional pixels."""
    return [n / 120 for n in range(60, 361) if (w * 120) % n == 0 and (h * 120) % n == 0]


def nearest(values, target):
    return min(values, key=lambda v: abs(v - target)) if values else target


# ---------------------------------------------------------------------------
# model
# ---------------------------------------------------------------------------

class Monitor:
    """One output. width/height/refresh are the physical mode; x/y the
    position in Hyprland's logical layout (already scaled and rotated)."""

    STATE_KEYS = ("width", "height", "refresh", "x", "y", "scale", "transform", "vrr", "disabled", "mirror")

    def __init__(self, d):
        self.name = d["name"]
        self.description = d.get("description") or ""
        self.make = d.get("make") or ""
        self.model = d.get("model") or ""
        self.modes = parse_modes(d.get("availableModes") or [])
        w, h = int(d.get("width") or 0), int(d.get("height") or 0)
        rr = round(float(d.get("refreshRate") or 60.0), 2)
        if not w or not h:
            w, h, rr = self.modes[0] if self.modes else (1920, 1080, 60.0)
        self.width, self.height, self.refresh = w, h, rr
        if not any(m[:2] == (w, h) and abs(m[2] - rr) < 0.05 for m in self.modes):
            self.modes.insert(0, (w, h, rr))
        self.x = int(d.get("x") or 0)
        self.y = int(d.get("y") or 0)
        self.scale = float(d.get("scale") or 1.0)
        self.transform = int(d.get("transform") or 0)
        self.vrr = 1 if d.get("vrr") else 0
        self.disabled = bool(d.get("disabled", False))
        mirror = str(d.get("mirrorOf") or "none")
        self.mirror = "" if mirror == "none" else mirror
        self.focused = bool(d.get("focused"))

    # comparable / restorable state (undo, "unapplied changes")
    def state(self):
        return (self.width, self.height, round(self.refresh, 2), int(round(self.x)), int(round(self.y)),
                round(self.scale, 4), self.transform, self.vrr, self.disabled, self.mirror)

    def set_state(self, st):
        for k, v in zip(self.STATE_KEYS, st):
            setattr(self, k, v)

    @property
    def subtitle(self):
        return f"{self.make} {self.model}".strip() or self.description

    @property
    def rotated(self):
        return self.transform % 2 == 1

    @property
    def logical_w(self):
        return (self.height if self.rotated else self.width) / self.scale

    @property
    def logical_h(self):
        return (self.width if self.rotated else self.height) / self.scale

    @property
    def in_layout(self):
        return not self.disabled and not self.mirror

    def mode_spec(self):
        return f"{self.width}x{self.height}@{fmt_refresh(self.refresh)}"

    def mode_index(self):
        return min(range(len(self.modes)),
                   key=lambda i: (self.modes[i][:2] != (self.width, self.height),
                                  abs(self.modes[i][2] - self.refresh)))

    def scales(self):
        scales = valid_scales(self.width, self.height)
        if not any(abs(s - self.scale) < 1e-4 for s in scales):
            scales = sorted(scales + [self.scale])
        return scales

    def lua_fields(self, explicit=False):
        """explicit=True also writes default values: needed with eval to
        reset rotation/VRR left over from a previous rule."""
        if self.disabled:
            return [("output", lua_str(self.name)), ("disabled", "true")]
        fields = [
            ("output", lua_str(self.name)),
            ("mode", lua_str(self.mode_spec())),
            ("position", lua_str(f"{int(round(self.x))}x{int(round(self.y))}")),
            ("scale", fmt_scale(self.scale)),
        ]
        if self.transform or explicit:
            fields.append(("transform", str(self.transform)))
        if self.vrr or explicit:
            fields.append(("vrr", str(self.vrr)))
        if self.mirror:
            fields.append(("mirror", lua_str(self.mirror)))
        if explicit:
            fields.append(("disabled", "false"))
        return fields

    def lua_inline(self, explicit=False):
        return "hl.monitor({ " + ", ".join(f"{k} = {v}" for k, v in self.lua_fields(explicit)) + " })"


def build_monitors(data, config_path):
    by_id = {str(d.get("id")): d["name"] for d in data}
    monitors = [Monitor(d) for d in data]
    for m in monitors:
        if m.mirror in by_id:  # hyprctl reports the id of the mirrored output
            m.mirror = by_id[m.mirror]
    # hyprctl only says whether VRR is on, not the mode: read it from the file
    try:
        blocks = find_monitor_blocks(config_path.read_text())
    except OSError:
        blocks = []
    for m in monitors:
        for b in blocks:
            out = block_output(b)
            if out and output_matches(out, m):
                vrr = dict(b["fields"]).get("vrr", "")
                if vrr.isdigit():
                    m.vrr = int(vrr)
    return monitors


def apply_layout(monitors):
    # enabled screens first, then mirrors, disabled ones last: this way we
    # never end up halfway through with no output turned on
    order = sorted(monitors, key=lambda m: (m.disabled, bool(m.mirror)))
    for m in order:
        hypr_eval(m.lua_inline(explicit=True))


