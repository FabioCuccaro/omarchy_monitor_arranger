    def _setup_actions(self, app):
        for name, cb, accels in (
            ("undo", self.undo, ["<Control>z"]),
            ("reload", self.reload_live, ["F5"]),
            ("apply", self.do_apply, ["<Control>Return"]),
            ("save", self.do_save, ["<Control>s"]),
            ("identify", self.identify, ["<Control>i"]),
        ):
            action = Gio.SimpleAction.new(name, None)
            action.connect("activate", lambda *_, cb=cb: cb())
            self.add_action(action)
            app.set_accels_for_action(f"win.{name}", accels)
        self.undo_action = self.lookup_action("undo")
        self.undo_action.set_enabled(False)

    # ----- model -----
    def _assign_colors(self):
        names = sorted(m.name for m in self.monitors)
        self.color_index = {n: i % len(self.palette) for i, n in enumerate(names)}

    def color_of(self, mon):
        return self.palette[self.color_index.get(mon.name, 0)]

    def by_name(self, name):
        return next((m for m in self.monitors if m.name == name), None)

    def layout_monitors(self):
        return [m for m in self.monitors if m.in_layout]

    def overlapping_names(self):
        lay = self.layout_monitors()
        return {m.name for a in lay for b in lay if a is not b and overlaps(a, b) for m in (a, b)}

    def snapshot(self):
        return {m.name: m.state() for m in self.monitors}

    def normalize(self):
        lay = self.layout_monitors()
        if not lay:
            return
        mx, my = min(m.x for m in lay), min(m.y for m in lay)
        for m in lay:
            m.x, m.y = int(round(m.x - mx)), int(round(m.y - my))

    def push_undo(self, key=None, snap=None):
        now = time.monotonic()
        if key and key == self._undo_key and now - self._undo_time < 1.2:
            self._undo_time = now
            return
        self._undo_key, self._undo_time = key, now
        self.undo_stack.append(snap or self.snapshot())
        del self.undo_stack[:-100]
        self.undo_action.set_enabled(True)

    def undo(self):
        if not self.undo_stack:
            return
        snap = self.undo_stack.pop()
        for m in self.monitors:
            if m.name in snap:
                m.set_state(snap[m.name])
        self._undo_key = None
        self.undo_action.set_enabled(bool(self.undo_stack))
        self.after_change(rebuild=True)

    def change_geometry(self, mon, mutate):
        """Apply a size change (mode, scale, rotation) keeping the screens
        that touched it on the right and below attached."""
        lay = [o for o in self.layout_monitors() if o is not mon]
        old_r, old_b = mon.x + mon.logical_w, mon.y + mon.logical_h
        right = [o for o in lay if abs(o.x - old_r) < 1 and
                 min(o.y + o.logical_h, old_b) - max(o.y, mon.y) > 0]
        below = [o for o in lay if abs(o.y - old_b) < 1 and
                 min(o.x + o.logical_w, old_r) - max(o.x, mon.x) > 0]
        mutate()
        dr, db = mon.x + mon.logical_w - old_r, mon.y + mon.logical_h - old_b
        for o in right:
            o.x = int(round(o.x + dr))
        for o in below:
            o.y = int(round(o.y + db))
        self.normalize()

    def auto_arrange(self):
        lay = self.layout_monitors()
        if len(lay) < 2:
            return
        self.push_undo()
        span_w = max(m.x + m.logical_w for m in lay) - min(m.x for m in lay)
        span_h = max(m.y + m.logical_h for m in lay) - min(m.y for m in lay)
        if span_h > span_w:  # stacked: in a column, centred
            lay.sort(key=lambda m: m.y + m.logical_h / 2)
            widest = max(m.logical_w for m in lay)
            y = 0
            for m in lay:
                m.x, m.y = int(round((widest - m.logical_w) / 2)), int(round(y))
                y += m.logical_h
        else:  # side by side: in a row, bottom-aligned
            lay.sort(key=lambda m: m.x + m.logical_w / 2)
            tallest = max(m.logical_h for m in lay)
            x = 0
            for m in lay:
                m.x, m.y = int(round(x)), int(round(tallest - m.logical_h))
                x += m.logical_w
        self.after_change()
        self.toast("Screens re-aligned — Ctrl+Z to undo")

    # ----- view updates -----
    def after_change(self, live=False, rebuild=False):
        self.canvas.queue_draw()
        if live:  # while dragging: only the bare minimum
            self._sync_position_rows()
            return
        self._update_status()
        self._update_list_rows()
        if rebuild:
            GLib.idle_add(self._rebuild_settings_idle)
        else:
            self._sync_position_rows()
        self.preview_label.set_text("\n\n".join(render_block(m) for m in self.monitors))

    def _update_status(self):
        lay = self.layout_monitors()
        dirty = self.snapshot() != self.live_state
        n = len(lay)
        subtitle = f"{n} active {'screen' if n == 1 else 'screens'}"
        subtitle += " · unapplied changes" if dirty else " · current"
        if self.mock:
            subtitle += " · demo"
        self.title_widget.set_subtitle(subtitle)

        problems = []
        bad = sorted(self.overlapping_names())
        if bad:
            problems.append(f"{' and '.join(bad)} overlap")
        far = detached_monitors(lay)
        if far:
            names = ", ".join(m.name for m in far)
            problems.append(f"{names} {'does' if len(far) == 1 else 'do'} not touch the others: "
                            "the cursor can't reach it")
        if problems:
            self.warning_label.set_text(" · ".join(problems))
        self.warning.set_reveal_child(bool(problems))

    def _status_text(self, mon):
        if mon.disabled:
            return "off"
        if mon.mirror:
            return f"mirrors {mon.mirror}"
        return f"{mon.width}×{mon.height} · {scale_label(mon.scale)}×"

    def rebuild_list(self):
        self._syncing = True
        while (row := self.listbox.get_row_at_index(0)) is not None:
            self.listbox.remove(row)
        self._list_rows = []
        for mon in self.monitors:
            row = Adw.ActionRow(title=mon.name, subtitle=mon.subtitle, subtitle_lines=1)
            dot = Gtk.Box(valign=Gtk.Align.CENTER)
            dot.add_css_class("mon-dot")
            dot.add_css_class(f"mon-dot-{self.color_index.get(mon.name, 0)}")
            row.add_prefix(dot)
            status = Gtk.Label()
            status.add_css_class("dim-label")
            status.add_css_class("caption")
            row.add_suffix(status)
            self.listbox.append(row)
            self._list_rows.append((row, status))
            if mon is self.selected:
                self.listbox.select_row(row)
        self._syncing = False
        self._update_list_rows()

    def _update_list_rows(self):
        for mon, (row, status) in zip(self.monitors, self._list_rows):
            status.set_text(self._status_text(mon))
            if mon.disabled:
                row.add_css_class("dim-label")
            else:
                row.remove_css_class("dim-label")

    def _on_row_selected(self, _lb, row):
        if self._syncing or row is None:
            return
        self.select(self.monitors[row.get_index()])

    def select(self, mon):
        if mon is self.selected and self._setting_rows:
            return
        self.selected = mon
        if self._list_rows and mon in self.monitors:
            self._syncing = True
            self.listbox.select_row(self._list_rows[self.monitors.index(mon)][0])
            self._syncing = False
        self.rebuild_settings()
        self.canvas.queue_draw()

    def select_next(self):
        if not self.monitors:
            return
        i = self.monitors.index(self.selected) if self.selected in self.monitors else -1
        self.select(self.monitors[(i + 1) % len(self.monitors)])

    # ----- settings panel -----
    def _rebuild_settings_idle(self):
        self.rebuild_settings()
        return False

    def rebuild_settings(self):
        for row in self._setting_rows:
            self.settings_group.remove(row)
        self._setting_rows, self._pos_rows = [], None
        mon = self.selected
        if mon is None:
            self.settings_group.set_title("")
            self.settings_group.set_description(None)
            return
        self.settings_group.set_title(mon.name)
        self.settings_group.set_description(mon.description or None)
        self._syncing = True

        on = Adw.SwitchRow(title="Enabled", subtitle="When off, the screen leaves the layout")
        on.set_active(not mon.disabled)
        on.connect("notify::active", self._on_enabled)

        mode_labels = [f"{w}×{h} @ {fmt_refresh(rr)} Hz" for w, h, rr in mon.modes]
        mode = Adw.ComboRow(title="Resolution", subtitle=f"native {mon.modes[0][0]}×{mon.modes[0][1]}",
                            model=Gtk.StringList.new(mode_labels))
        mode.set_selected(mon.mode_index())
        mode.connect("notify::selected", self._on_mode)

        scales = mon.scales()
        scale_labels = []
        for s in scales:
            lw, lh = (mon.height, mon.width) if mon.rotated else (mon.width, mon.height)
            scale_labels.append(f"{scale_label(s)}× · {lw / s:.0f}×{lh / s:.0f}")
        scale = Adw.ComboRow(title="Scale", tooltip_text="Only scales with an integer logical size",
                             model=Gtk.StringList.new(scale_labels))
        scale.set_selected(min(range(len(scales)), key=lambda i: abs(scales[i] - mon.scale)))
        scale.connect("notify::selected", self._on_scale, scales)

        rot = Adw.ComboRow(title="Rotation", model=Gtk.StringList.new([t[1] for t in TRANSFORMS]))
        rot.set_selected(mon.transform)
        rot.connect("notify::selected", self._on_transform)

        targets = [m.name for m in self.monitors if m is not mon and not m.disabled and not m.mirror]
        mirror = Adw.ComboRow(title="Mirror",
                              subtitle="Same content as another screen",
                              model=Gtk.StringList.new(["No"] + targets))
        mirror.set_selected(targets.index(mon.mirror) + 1 if mon.mirror in targets else 0)
        mirror.connect("notify::selected", self._on_mirror, targets)

        vrr = Adw.ComboRow(title="Variable refresh rate (VRR)",
                           model=Gtk.StringList.new([v[1] for v in VRR_MODES]))
        vrr.set_selected(mon.vrr if 0 <= mon.vrr < len(VRR_MODES) else 0)
        vrr.connect("notify::selected", self._on_vrr)

        pos_x = Adw.SpinRow.new_with_range(-32768, 32768, 1)
        pos_x.set_title("Position X")
        pos_y = Adw.SpinRow.new_with_range(-32768, 32768, 1)
        pos_y.set_title("Position Y")
        pos_x.set_value(mon.x)
        pos_y.set_value(mon.y)
        pos_x.connect("notify::value", self._on_position, "x")
        pos_y.connect("notify::value", self._on_position, "y")
        self._pos_rows = (pos_x, pos_y)

        for row in (mode, scale, rot, mirror, vrr, pos_x, pos_y):
            row.set_sensitive(not mon.disabled)
        for row in (mode, scale, rot, pos_x, pos_y):
            if mon.mirror:
                row.set_sensitive(False)
        self._setting_rows = [on, mode, scale, rot, mirror, vrr, pos_x, pos_y]
        for row in self._setting_rows:
            self.settings_group.add(row)
        self._syncing = False

    def _sync_position_rows(self):
        if not self._pos_rows or not self.selected:
            return
        self._syncing = True
        self._pos_rows[0].set_value(self.selected.x)
        self._pos_rows[1].set_value(self.selected.y)
        self._syncing = False

    def _on_enabled(self, row, _pspec):
        if self._syncing:
            return
        mon = self.selected
        enable = row.get_active()
        if not enable and not [m for m in self.layout_monitors() if m is not mon]:
            self._syncing = True
            row.set_active(True)
            self._syncing = False
            self.toast("At least one screen must stay on")
            return
        self.push_undo()
        mon.disabled = not enable
        if mon.disabled:
            for m in self.monitors:
                if m.mirror == mon.name:
                    m.mirror = ""
        else:
            others = [m for m in self.layout_monitors() if m is not mon]
            if others and any(overlaps(mon, o) for o in others):
                mon.x = int(round(max(o.x + o.logical_w for o in others)))
                mon.y = int(round(min(o.y for o in others)))
        self.normalize()
        self.after_change(rebuild=True)

    def _on_mode(self, row, _pspec):
        if self._syncing:
            return
        mon = self.selected
        w, h, rr = mon.modes[row.get_selected()]
        if (w, h, rr) == (mon.width, mon.height, mon.refresh):
            return
        self.push_undo()

        def mutate():
            mon.width, mon.height, mon.refresh = w, h, rr
            mon.scale = nearest(valid_scales(w, h), mon.scale)
        self.change_geometry(mon, mutate)
        self.after_change(rebuild=True)

    def _on_scale(self, row, _pspec, scales):
        if self._syncing:
            return
        mon = self.selected
        new = scales[row.get_selected()]
        if abs(new - mon.scale) < 1e-6:
            return
        self.push_undo()
        self.change_geometry(mon, lambda: setattr(mon, "scale", new))
        self.after_change()

    def _on_transform(self, row, _pspec):
        if self._syncing:
            return
        mon = self.selected
        if row.get_selected() == mon.transform:
            return
        self.push_undo()
        self.change_geometry(mon, lambda: setattr(mon, "transform", row.get_selected()))
        self.after_change(rebuild=True)

    def _on_mirror(self, row, _pspec, targets):
        if self._syncing:
            return
        mon = self.selected
        i = row.get_selected()
        if (targets[i - 1] if i > 0 else "") == mon.mirror:
            return
        self.push_undo()
        mon.mirror = targets[i - 1] if i > 0 else ""
        if mon.mirror:
            for m in self.monitors:
                if m.mirror == mon.name:  # no mirror chains
                    m.mirror = ""
        else:
            others = [m for m in self.layout_monitors() if m is not mon]
            if others and any(overlaps(mon, o) for o in others):
                mon.x = int(round(max(o.x + o.logical_w for o in others)))
                mon.y = int(round(min(o.y for o in others)))
        self.normalize()
        self.after_change(rebuild=True)

    def _on_vrr(self, row, _pspec):
        if self._syncing:
            return
        vrr = VRR_MODES[row.get_selected()][0]
        if vrr == self.selected.vrr:
            return
        self.push_undo()
        self.selected.vrr = vrr
        self.after_change()

    def _on_position(self, row, _pspec, axis):
        if self._syncing:
            return
        mon = self.selected
        value = int(row.get_value())
        if value == int(round(getattr(mon, axis))):
            return  # SpinRow also notifies when it is shown
        self.push_undo(key=f"pos-{mon.name}-{axis}")
        setattr(mon, axis, value)
        self.after_change()

    # ----- actions -----
    def toast(self, title, button=None, action=None, timeout=4):
        t = Adw.Toast(title=GLib.markup_escape_text(title), timeout=timeout)
        if button:
            t.set_button_label(button)
            t.set_action_name(action)
        self.toasts.add_toast(t)

    def alert(self, heading, body):
        d = Adw.AlertDialog(heading=heading, body=body)
        d.add_response("ok", "OK")
        d.present(self)

    def reload_live(self):
        if self.mock:
            self.toast("Demo mode: nothing to reload")
            return
        try:
            fresh = build_monitors(read_live_monitors(), self.config_path)
        except HyprError as e:
            self.alert("Couldn't read the monitors", str(e))
            return
        self.push_undo()
        selected = self.selected.name if self.selected else None
        self.monitors = fresh
        self.live_state = self.snapshot()
        self._assign_colors()
        self.selected = None
        self.rebuild_list()
        self.select(self.by_name(selected) or (fresh[0] if fresh else None))
        self.after_change()
        self.toast("Configuration reloaded from Hyprland")

    def do_apply(self):
        if self.mock:
            self.toast("Demo mode: no changes applied")
            return
        if self._pending_revert:
            return
        self.normalize()
        self.after_change()
        try:
            previous = build_monitors(read_live_monitors(), self.config_path)
        except HyprError as e:
            self.alert("Couldn't read the monitors", str(e))
            return
        try:
            apply_layout(self.monitors)
        except HyprError as e:
            try:
                apply_layout(previous)
            except HyprError:
                pass
            self.alert("Configuration not applied", f"Hyprland replied:\n{e}")
            return

        def keep():
            self.live_state = self.snapshot()
            self._update_status()
            self.toast("Applied. Save it to keep it after a restart",
                       button="Save", action="win.save", timeout=8)

        def revert():
            apply_layout(previous)
            self.toast("Previous configuration restored")

        self.confirm_keep(keep, revert)

    def do_save(self):
        if self._pending_revert:
            return
        self.normalize()
        self.after_change()
        previous = None
        if not self.mock:
            try:
                previous = {m.name: m.state() for m in build_monitors(read_live_monitors(), self.config_path)}
            except HyprError:
                previous = None
        try:
            original, backup = write_config(self.config_path, self.monitors)
        except OSError as e:
            self.alert("Save failed", str(e))
            return
        where = str(self.config_path).replace(str(Path.home()), "~")
        if self.mock:
            self.toast(f"Saved to {where} (demo)")
            return

        def restore():
            self.config_path.write_text(original or "")
            hyprctl("reload")

        try:
            hyprctl("reload")
            errors = config_errors()
        except HyprError as e:
            self.alert("Saved, but Hyprland did not respond", str(e))
            return
        if errors:
            d = Adw.AlertDialog(heading="The configuration has errors",
                                body="\n".join(errors[:8]))
            d.add_response("keep", "Keep it")
            d.add_response("restore", "Restore the previous file")
            d.set_response_appearance("restore", Adw.ResponseAppearance.DESTRUCTIVE)

            def on_response(_d, response):
                if response == "restore":
                    try:
                        restore()
                        self.toast("Previous file restored")
                    except (OSError, HyprError) as e:
                        self.alert("Restore failed", str(e))
            d.connect("response", on_response)
            d.present(self)
            return

        saved_msg = f"Saved to {where}" + (f" · backup {backup.name}" if backup else "")
        if previous is not None and previous != self.snapshot():
            def keep():
                self.live_state = self.snapshot()
                self._update_status()
                self.toast(saved_msg, timeout=6)

            def revert():
                restore()
                self.toast("Previous monitors.lua restored")
            self.confirm_keep(keep, revert)
        else:
            self.live_state = self.snapshot()
            self._update_status()
            self.toast(saved_msg, timeout=6)

    def confirm_keep(self, on_keep, on_revert):
        """Ask to confirm the new configuration; without an answer (e.g. a
        black or misplaced screen) it rolls back on its own."""
        remaining = [REVERT_SECONDS]
        done = [False]

        def body():
            return (f"Unless you confirm, the previous configuration will be restored "
                    f"in {remaining[0]} seconds.")

        dialog = Adw.AlertDialog(heading="Keep this configuration?", body=body())
        dialog.add_response("revert", "Revert")
        dialog.add_response("keep", "Keep")
        dialog.set_response_appearance("keep", Adw.ResponseAppearance.SUGGESTED)
        dialog.set_default_response("keep")
        dialog.set_close_response("revert")

        def finish(keep):
            if done[0]:
                return
            done[0] = True
            if timer[0]:
                GLib.source_remove(timer[0])
                timer[0] = None
            self._pending_revert = None
            try:
                on_keep() if keep else on_revert()
            except (OSError, HyprError) as e:
                self.alert("Restore failed", str(e))

        def tick():
            remaining[0] -= 1
            if remaining[0] <= 0:
                timer[0] = None
                finish(False)
                dialog.force_close()
                return False
            dialog.set_body(body())
            return True

        timer = [GLib.timeout_add_seconds(1, tick)]
        self._pending_revert = lambda: finish(False)
        dialog.connect("response", lambda _d, r: finish(r == "keep"))
        dialog.present(self)

    def _on_close_request(self, *_):
        if self._pending_revert:
            self._pending_revert()
        return False

    def identify(self):
        if LayerShell is None or not LayerShell.is_supported():
            self.toast("Identify is not available (needs gtk4-layer-shell)")
            return
        for w in self._identify_windows:
            w.destroy()
        self._identify_windows = []
        gdk_monitors = Gdk.Display.get_default().get_monitors()
        for i in range(gdk_monitors.get_n_items()):
            gm = gdk_monitors.get_item(i)
            mon = self.by_name(gm.get_connector() or "")
            win = Gtk.Window()
            win.add_css_class("identify-window")
            LayerShell.init_for_window(win)
            LayerShell.set_layer(win, LayerShell.Layer.OVERLAY)
            LayerShell.set_namespace(win, "monitor-arranger-identify")
            LayerShell.set_keyboard_mode(win, LayerShell.KeyboardMode.NONE)
            LayerShell.set_monitor(win, gm)
            card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            card.add_css_class("identify-card")
            if mon:
                card.add_css_class(f"identify-{self.color_index.get(mon.name, 0)}")
            name = Gtk.Label(label=gm.get_connector() or "?")
            name.add_css_class("identify-name")
            card.append(name)
            sub = Gtk.Label(label=(f"{mon.subtitle}\n{mon.width}×{mon.height} · scale {scale_label(mon.scale)}"
                                   if mon else gm.get_description() or ""), justify=Gtk.Justification.CENTER)
            sub.add_css_class("identify-sub")
            card.append(sub)
            win.set_child(card)
            win.present()
            self._identify_windows.append(win)

        def close():
            for w in self._identify_windows:
                w.destroy()
            self._identify_windows = []
            return False
        GLib.timeout_add(2500, close)

    def _copy_preview(self):
        self.get_clipboard().set("\n\n".join(render_block(m) for m in self.monitors) + "\n")
        self.toast("Lua code copied")

    def _open_config(self):
        if not self.config_path.exists():
            self.toast("The file doesn't exist yet: press “Save” to create it")
            return
        Gtk.FileLauncher.new(Gio.File.new_for_path(str(self.config_path))).launch(self, None, None)


# ---------------------------------------------------------------------------
# application
# ---------------------------------------------------------------------------

class ArrangerApp(Adw.Application):
    def __init__(self, use_mock, config_path):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)
        self.use_mock = use_mock
        self.config_path = config_path

    def do_activate(self):
        if self.props.active_window:
            self.props.active_window.present()
            return
        theme, found = load_theme()
        css, palette = build_css(theme, found)
        provider = Gtk.CssProvider()
        provider.load_from_string(css)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), provider,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        if found:
            Adw.StyleManager.get_default().set_color_scheme(
                Adw.ColorScheme.FORCE_LIGHT if theme.get("mode") == "light" else Adw.ColorScheme.FORCE_DARK)

        mock, warning = self.use_mock, None
        config_path = self.config_path
        if not mock:
            try:
                data = read_live_monitors()
            except HyprError as e:
                mock, warning = True, f"{e} — using demo data"
        if mock:
            data = MOCK_MONITORS
            if config_path == DEFAULT_CONFIG_PATH:
                config_path = Path(tempfile.gettempdir()) / "monitor-arranger-demo.lua"

        win = ArrangerWindow(self, build_monitors(data, config_path), config_path, mock, theme, palette)
        win.present()
        if warning:
            win.toast(warning, timeout=8)


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--mock", action="store_true",
                        help="use fake data instead of reading from hyprctl (to try out the UI)")
    parser.add_argument("--config", type=Path, default=DEFAULT_CONFIG_PATH,
                        help=f"path to the monitors.lua file (default: {DEFAULT_CONFIG_PATH})")
    args = parser.parse_args()
    ArrangerApp(args.mock, args.config.expanduser()).run([])


if __name__ == "__main__":
    main()
